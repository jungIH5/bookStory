# ── 데이터베이스 (PostgreSQL / Supabase) ─────────────────────────────────────
# docker-compose 로컬 실행 시: postgresql://user:password@db:5432/bookstory
# Supabase 사용 시: Supabase 프로젝트 Settings > Database > Connection string
DATABASE_URL=

# ── AI API 키 ─────────────────────────────────────────────────────────────────
# Claude (책 분석·질문 생성·성향 분석·추천): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI Whisper (녹음 음성→텍스트 전사): https://platform.openai.com
OPENAI_API_KEY=

# ── 카카오 Open API ──────────────────────────────────────────────────────────
# 책 검색(네이버 책 검색 API가 계정 단에서 막혀 카카오로 교체): https://developers.kakao.com
KAKAO_REST_API_KEY=

# ── 네이버 Open API ──────────────────────────────────────────────────────────
# 블로그 서평 수집 전용(책 검색은 위 카카오로 대체됨): https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── HuggingFace (화자 분리) ──────────────────────────────────────────────────
# pyannote/speaker-diarization-3.1 모델 이용 약관 동의 후 토큰 발급
# https://huggingface.co/pyannote/speaker-diarization-3.1
# 녹음 분석 기능을 사용하지 않으면 불필요
HUGGINGFACE_TOKEN=

# ── 소셜 로그인 (OAuth) ──────────────────────────────────────────────────────
# 각 플랫폼 개발자 콘솔에서 발급. 안 채운 provider는 해당 로그인 버튼만 비활성(다른 기능엔 영향 없음).
# Redirect URI는 각 콘솔에 FRONTEND_URL과 정확히 같은 주소로 등록해야 한다(로컬: http://localhost:8080).
KAKAO_CLIENT_ID=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:8080

# ── 인증 ─────────────────────────────────────────────────────────────────────
# JWE 토큰 서명 키 (32바이트 이상의 임의 문자열로 변경 필수)
JWT_SECRET=bookstory-default-secret-change-me!!

# 관리자 진입 비밀번호 (기본값 2345, 운영 환경에서는 변경 권장)
ADMIN_ENTRY_PASSWORD=2345

# ── 서버 설정 ─────────────────────────────────────────────────────────────────
PORT=5001

# ── CORS (쉼표로 구분, 운영 환경에서는 실제 도메인으로 변경) ────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:19006
