{
  "expo": {
    "name": "bookStory",
    "slug": "bookstory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookstory",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFAF6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bookstory.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "독서모임 녹음 분석을 위해 마이크 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "가까운 독서모임을 찾기 위해 위치 정보가 필요합니다.",
        "NSPhotoLibraryUsageDescription": "모임 이미지를 선택하기 위해 사진 라이브러리 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.bookstory.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFAF6"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "독서모임 녹음 분석을 위해 마이크 권한이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 독서모임을 찾기 위해 위치 정보가 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "모임 이미지 선택을 위해 사진 라이브러리 접근이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
